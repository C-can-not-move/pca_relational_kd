# prkd.ini.example —— 一次运行的配置（示例 / 模板）
#
# 用法：复制成 prkd.ini，再把 【要改的三处】 填上。
#        pca_relational_kd [配置文件路径] [任务名]
          不给配置文件路径 → 当前目录下的 prkd.ini
          不给任务名       → 用下面 run.task 的值

# 任务名：
#   base18    训练 resnet18 基准
#   pre152    训练 resnet152
#   kd        关系蒸馏（教师只取特征，见文件末尾 kd.* 段）
#   eval18    评估 resnet18 的权重（读 run.ckpt，只用 val）
#   eval152   评估 resnet152 的权重（同上）
# 打不开这个文件 → 直接报错退出（没有"用默认值跑起来"这种退路）。
#
# 规则：
#   · 平铺的 key = value，# 后面是注释（整行或行尾都行）
#   · 按【第一个】= 切分，值里可以再有 =
#   · 未知 key 报错并带行号；拼错的 worker = 8 不会静默失效
#   · true / false 只认这两个小写词
#
# ★ 当前入口是【ResNet-18 的 ImageNet 训练循环】：
#   建模型、上 GPU、每轮训练 + 评估，并产出三类文件：
#     out_dir/train/<name>_seed<seed>/auto/        每轮覆盖：权重 + 优化器 + 状态（续跑用）
#     out_dir/train/<name>_seed<seed>/best/        训练后段每次刷新覆盖：只有权重
#     out_dir/pretrained/<name>_acc<acc>           收尾导一次：文本键表格式，给以后拿去用
#   启动时按 run.seed 自动找断点，有就接着跑。
#   ckpt / aloi.* 现在还没被读，保留是为了把 ALOI + PCA 那段接回来时不用改结构。

# ---- 在哪读 ----

# 跑哪个任务：改这一行就行（命令行第二个参数也认，会覆盖这里）
#   任务名一览见文件开头「用法」
run.task         = base18
run.dataset      = imagenet   # 当前入口只认 imagenet
run.data_dir     =            # ★ 要改：ImageNet 根目录（代码自己拼 /train 或 /val）
run.out_dir      =            # ★ 要改：存档与导出都落在它下面
#   <out_dir>/train/<name>_seed<seed>/{auto,best}    name = resnet18 / resnet152
#   <out_dir>/pretrained/<name>_acc<acc>
run.ckpt         =            # 权重前缀（不含扩展名）。eval18/eval152 读它；task=kd 时是【教师】
                              # 例：<out_dir>/resnet152_1000 或 <out_dir>/pretrained/resnet18_acc0.5493
run.device_index = 0          # 用哪块卡；-1 = 强制 CPU
run.seed         = 2026       # 同一个种子 = 同一个 run 目录；想从头跑就换种子或删目录

# ---- ALOI：视角范围就是它的 split（左闭右开）----
#
# 【当前入口用不到】—— run.dataset = imagenet 时这两行不会被读。
# 保留是因为它们记录了一条规则：跳过 _r0 目录靠的是"目录名必须全数字"，
# 不是靠这两个数。
#
#   全量看 PCA       [0, 360)     1000 类 × 72 = 72,000 张
#   半圈训练/测试     [0, 180) / [180, 360)      各 36,000 张
#   冒烟（只读 r0）   [0, 5)       1000 张
aloi.view_begin  = 0
aloi.view_end    = 360

# ---- 怎么读 ----
loader.workers    = 6      # 0 = 自动（逻辑核数/2 ≈ 物理核数）
loader.batch      = 64
loader.prefetch   = 4      # 预取池深度：同时几批在飞
loader.short_side = 256    # val 的 Resize 短边；V1 权重 256，V2 用 232
loader.crop       = 224

# 下面三项互相独立，谁也不派生谁 —— 三种模式各自把三行写全：
#
#   训练       train=true   shuffle=true   drop_last=true
#   评测       train=false  shuffle=false  drop_last=false   ← 末批可短
#   对拍用评测  train=false  shuffle=false  drop_last=true    ← 整除，但会丢末尾几张
#
# 只改 train 不改另外两行，会得到"中心裁剪但洗牌且丢尾巴"这种合法又反直觉的组合；
# 启动打印里 [cfg] 和 [loader] 两处都会把它列出来。
loader.train      = true
loader.shuffle    = true
loader.drop_last  = true

# ---- 训练配方 ----
# 这里【没有】batch：批属于 loader.batch，trainer 只收批。
# 两者要匹配：torchvision 的配方是 batch 256 配 lr 0.1；batch 64 的话 lr 约 0.025。
# 启动时会打一行 [train] batch=… lr=… —— 只报事实，不替你判断配比。
train.epochs       = 3
train.lr           = 0.1
train.momentum     = 0.9
train.weight_decay = 1e-4
train.log_every    = 50      # 每多少批打一行；0 = 不打

# 续跑时 lr 从哪儿来（只有存在断点时才起作用）：
#   config = 按本文件的 train.lr
#   keep   = 保留 opt.pt 里存的那份
# 原因：官方 archive 会把 lr / betas / weight_decay 一起存，加载时覆盖当前值。
train.resume_lr    = config

# best 从训练的哪个位置开始【写盘】（比例，不是轮数）：
#   0     每次都写 —— 最安全，但每刷新一次就是几十 MB
#   0.75  默认：前 3/4 的"最好"几乎必然被后面刷掉，只留内存；后 1/4 每次刷新就写
#   1     全程不写，只在收尾写一次 —— 最省，但崩溃时丢 best
# 内存里始终保留最新那份 best，收尾无论如何会落一次盘。
train.best_write_from = 0.75

# ---- 诊断 ----
debug.intra      = 1       # ATen intra-op 线程数；1 = 不让它和 worker 抢核
debug.selftest   = true    # 只决定是否打印模型参数量（数据对拍那段已随入口重写移除）
# ---- 关系蒸馏（只在 run.task = kd 时读）----
#
# 做法：教师（resnet152，ImageNet-1k 权重）与学生（resnet18）各自把特征投影到
#       PCA 子空间，然后比【批内成对距离矩阵】。教师的 fc 一次都不调。
#       ⇒ 不需要 wnid → 1000 类索引的映射，也不需要给教师换 200 类的头。
#
# 拟合 PCA 时师生必须喂【同一批图】，且只拟合一次（训练中特征分布在变）。

kd.keep        = 128      # PCA 保留的主轴数（师生取同样多，才能比距离）
kd.lambda      = 25.0     # 关系损失权重；0 = 退化成纯 CE（可当"同代码路径"的对照）
kd.pca_samples = 4096     # 拟合 PCA 用前多少张训练图（确定性顺序）

# 坐标系（轴）从哪儿来：
#   live   每次启动在当前学生上重拟合 —— 便宜；但断点前后换尺子，rkd 会跳
#   saved  第一次拟合后存入 auto/pca.{txt,bin}，之后一直读回 —— 一把尺子到底
kd.pca_source  = live
#
# 非空 ⇒ 学生侧的轴改用【这份权重】的模型来算，而不是训练中的学生。
#   好处：轴来自与本次训练无关的固定快照 ⇒ 跨运行完全可比。
#   例：<out_dir>/pretrained/resnet18_acc0.5493   200 类，fc 形状一致
#       <out_dir>/resnet18_1000                   1000 类，会自动跳过 fc
kd.pca_ckpt    =
