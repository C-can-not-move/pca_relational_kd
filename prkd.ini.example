# prkd.ini —— 一次运行的配置。
#
# 用法：pca_relational_kd [配置文件路径]      不给就是当前目录下的 prkd.ini
# 打不开这个文件 → 直接报错退出（没有"用默认值跑起来"这种退路）。
#
# 规则：
#   · 平铺的 key = value，# 后面是注释（整行或行尾都行）
#   · 按【第一个】= 切分，值里可以再有 =
#   · 未知 key 报错并带行号；拼错的 worker = 8 不会静默失效
#   · true / false 只认这两个小写词

# ---- 在哪训 ----
run.data_dir     = 
run.out_dir      = 
run.device_index = 0
run.seed         = 2026

# ---- 怎么读 ----
loader.workers    = 6      # 0 = 自动（逻辑核数/2 ≈ 物理核数）；本机 6
loader.batch      = 64
loader.short_side = 256    # val 的 Resize 短边；V1 权重 256，V2 用 232
loader.crop       = 224
loader.train      = true   # false = val 分支（不洗牌、末批可短）

# ---- 诊断 ----
debug.intra      = 1       # ATen intra-op 线程数；1 = 不让它和 worker 抢核
debug.selftest   = true    # 扫参数时改 false，省两次索引构建
